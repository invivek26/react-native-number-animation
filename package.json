{
  "name": "react-native-number-animation",
  "version": "0.1.0",
  "description": "High-performance native rolling number animations for React Native",
  "main": "./lib/module/index.js",
  "react-native": "./src/index.tsx",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-number-animation-source": "./src/index.tsx",
      "react-native": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "bun --filter react-native-number-animation-example",
    "build": "bob build",
    "clean": "del-cli lib",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "bun run clean && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "keywords": [
    "react-native",
    "animation",
    "counter",
    "odometer",
    "number",
    "fabric",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invivek26/react-native-number-animation.git"
  },
  "author": "Vivek Indlebele Narasimha Prasad <vivek@gamestock.app> (https://github.com/invivek26)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/invivek26/react-native-number-animation/issues"
  },
  "homepage": "https://github.com/invivek26/react-native-number-animation#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.1",
    "@changesets/cli": "^2.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/eslint-plugin": "0.85.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "@types/bun": "^1.3.11",
    "@types/react": "^19.2.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-builder-bob": "^0.43.0",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20.0.0",
    "react-native": ">=0.85.0 <0.86.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=20.19.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "NumberAnimationViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.numberanimation"
    },
    "ios": {
      "components": {
        "NumberAnimationView": {
          "className": "NumberAnimationView"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  }
}
